# Server configuration
PORT=8000
DEBUG=False

# Database (PostgreSQL with pgvector)
# Lokal rejimda:
DB_DIALECT=postgres
DB_NAME=pinterest_db
DB_USER=ogabek
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432

# Yoki to'liq DATABASE_URL (Docker yoki AWS RDS uchun):
# DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/pinterest_db

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pin-images
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Google OAuth & Security
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
JWT_SECRET_KEY=your_super_secret_jwt_key_here
COOKIE_NAME=access_token
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CLIP Embedder mikroxizmati (Lokalda 8001, Dockerda http://embedder:8001)
EMBEDDER_URL=http://127.0.0.1:8001

# CORS ruxsat berilgan frontend domenlari (vergul bilan ajrating yoki * qo'ying)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sizning-app.vercel.app

